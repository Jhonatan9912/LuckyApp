# Cabeceras de seguridad para la versión web (Apache / Hostinger).
# Estas cabeceras NO rompen Flutter Web y reducen clickjacking, sniffing y fugas.
<IfModule mod_headers.c>
    # Evita que el sitio se embeba en un iframe de otro dominio (clickjacking).
    Header always set X-Frame-Options "DENY"
    # El navegador respeta el Content-Type declarado (no "adivina").
    Header always set X-Content-Type-Options "nosniff"
    # No envía la URL completa como referer a otros sitios.
    Header always set Referrer-Policy "no-referrer"
    # Fuerza HTTPS durante 1 año.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Desactiva APIs del navegador que la app no usa.
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # --- Content-Security-Policy (OPCIONAL) ---
    # Flutter Web + google_fonts + la API de Railway. Está comentada porque una
    # CSP mal ajustada puede dejar el sitio en blanco: actívala y PRUEBA la web
    # (login, fuentes, llamadas a la API) antes de darla por buena.
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://luckyapp-production-ca29.up.railway.app https://fonts.gstatic.com https://fonts.googleapis.com; worker-src 'self' blob:; frame-ancestors 'none'"
</IfModule>

# Dominio canónico: fuerza HTTPS y quita "www" (cambiemostumundo.com).
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Solo para el dominio real (la URL temporal de Hostinger no se toca).
    RewriteCond %{HTTP_HOST} cambiemostumundo\.com$ [NC]
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://cambiemostumundo.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Caché: los archivos pesados se guardan en el navegador; los de arranque se
# revalidan siempre (respuesta 304 rápida) para que cada despliegue llegue.
<IfModule mod_headers.c>
    <FilesMatch "\.(wasm|png|jpg|jpeg|webp|gif|svg|ico|otf|ttf|woff2?|mp3|wav|bin)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "^(index\.html|flutter_bootstrap\.js|main\.dart\.js|flutter_service_worker\.js|version\.json|manifest\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
